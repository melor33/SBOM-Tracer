{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "package": { "type": "string" },
          "libraries": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["package", "libraries"],
        "additionalProperties": false
      }
    }
  },
  "required": ["packages"],
  "additionalProperties": false
}
